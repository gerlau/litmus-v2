# true  → connect to ~/.litmus-v2/data.db  (pre-seeded mock data)
# false → connect to ~/.litmus-v2/real.db   (blank, user fills in)
LITMUS_USE_MOCK=true

# Daily Reading AI summary
# Pick a small, fast Ollama model to avoid timeouts.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_SUMMARY_INPUT_MAX_CHARS=8000
